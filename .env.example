# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, works out of the box). To swap to PostgreSQL later, set
# DATABASE_URL to a postgres:// URL — the Prisma schema is portable.
DATABASE_URL="file:./dev.db"

# ─── Admin access (used to seed the first admin account) ────────────────────
# Change these before running the seed script in production.
ADMIN_EMAIL="admin@rynevotechnologys.com"
ADMIN_PASSWORD="change-me-please-1f3a9"
JWT_SECRET="generate-a-long-random-string-here-64-chars-min"

# ─── Email notifications (optional) ─────────────────────────────────────────
# Without SMTP settings, form submissions are stored in the database and
# logged to the server console instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Rynevo Technologys <no-reply@rynevotechnologys.com>"
MAIL_TO="hello@rynevotechnologys.com"

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
