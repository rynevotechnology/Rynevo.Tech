// Rynevo Technologys — database schema.
// Written against Prisma's portable column layer: switch DATABASE_URL from a
// SQLite file to a PostgreSQL URL and run `prisma migrate` to swap engines.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("EDITOR") // "ADMIN" | "EDITOR"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ContactInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  services    String   // comma-separated service slugs
  budget      String?
  message     String
  status      String   @default("NEW") // "NEW" | "IN_PROGRESS" | "CLOSED"
  source      String   @default("contact-page")
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Job {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  category     String    // FRONTEND | BACKEND | FULLSTACK | AI_ML | DESIGN | QA | MARKETING | INTERNSHIP
  jobType      String    // "full-time" | "contract" | "fixed-term"
  experience   String    // e.g. "Entry", "Mid", "Senior"
  location     String
  remote       Boolean   @default(false)
  published    Boolean   @default(false)
  summary      String
  description  String    // long-form, markdown-lite paragraphs separated by \n\n
  responsibilities String
  requirements String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id            String   @id @default(cuid())
  job           Job?     @relation(fields: [jobId], references: [id])
  jobId         String?
  name          String
  email         String
  phone         String?
  linkedin      String?
  portfolio     String?
  coverLetter   String?
  experienceYears String
  location      String?
  resumeName    String   // stored file name
  resumeSize    Int
  status        String   @default("RECEIVED") // "RECEIVED" | "REVIEWING" | "INTERVIEW" | "HIRED" | "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   // AI | WEB_DEV | SOFTWARE_ENGINEERING | TECH_TRENDS | BUSINESS_AUTOMATION | DIGITAL_TRANSFORMATION
  excerpt     String
  content     String   // markdown-lite: \n\n-separated blocks, lines starting with "## " become h2, "- " become list items
  readMinutes Int
  tags        String
  isFeatured  Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  industry    String
  category    String   // matches portfolio filters
  summary     String
  stack       String   // comma-separated
  isDemo      Boolean  @default(true)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String
  company     String
  quote       String
  isSample    Boolean  @default(true)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// NOTE: Categories and statuses are plain String fields (with app-level
// validation) so the schema works on SQLite and PostgreSQL alike.
